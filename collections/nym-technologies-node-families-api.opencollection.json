              },
              {
                "name": "output",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "get_family_by_id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/node-families/:family_id",
            "params": [
