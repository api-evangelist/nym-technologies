        {
          "info": {
            "name": "Accept a batch of stress-test results from an authorised network monitor orchestrator.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v3/nym-nodes/stress-testing/batch-submit",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "The batch is rejected unless all of the following hold:\n- the submission timestamp is within a short staleness window of the current time,\n- the signer's key is currently registered in the network-monitors contract,\n- the submission timestamp is strictly greater than the signer's previous accepted submission\n  (timestamp-based replay protection, so orchestrators don't need to keep a nonce counter),\n- the signature on the body verifies against the signer's key.\n\nIndividual result entries that fai"
        },
        {
          "info": {
            "name": "Report whether the given identity key is currently recognised by this nym-api as an\nauthorised network monitor orchestrator.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/nym-nodes/stress-testing/known-monitors/:identity_key",
            "params": [
              {
                "name": "identity_key",
                "value": "",
                "type": "path",
                "description": "base58-encoded ed25519 identity key of the queried network monitor"
              }
            ]
          },
          "docs": "Intended for orchestrators to self-check after (re)announcing their key on-chain - a\nsuccessful response with `authorised: true` means this nym-api has picked up the chain change\nand is ready to accept stress-test submissions signed by that key."
        }
